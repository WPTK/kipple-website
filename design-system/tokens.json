{
  "$description": "Kipple site design tokens, W3C design-tokens format. Every value is copied from style.css. Import with Tokens Studio for Figma. rem values assume a 16px root.",
  "color": {
    "scheme": {
      "paper":     { "kind": "light", "bg": { "$value": "#ffffff", "$type": "color" }, "surface": { "$value": "#f2f5f9", "$type": "color" }, "ink": { "$value": "#16181d", "$type": "color" }, "muted": { "$value": "#566070", "$type": "color" }, "line": { "$value": "#d8dde5", "$type": "color" }, "accent": { "$value": "#1a5fb4", "$type": "color" }, "on-accent": { "$value": "#ffffff", "$type": "color" } },
      "airmail":   { "kind": "light", "bg": { "$value": "#e2ecf5", "$type": "color" }, "surface": { "$value": "#d2e0ee", "$type": "color" }, "ink": { "$value": "#10202f", "$type": "color" }, "muted": { "$value": "#465b70", "$type": "color" }, "line": { "$value": "#b6c9db", "$type": "color" }, "accent": { "$value": "#1c5490", "$type": "color" }, "on-accent": { "$value": "#ffffff", "$type": "color" }, "stripe-red": { "$value": "#c8372d", "$type": "color" }, "stripe-blue": { "$value": "#1c5490", "$type": "color" } },
      "newsprint": { "kind": "light", "bg": { "$value": "#e6e5e1", "$type": "color" }, "surface": { "$value": "#dbdad5", "$type": "color" }, "ink": { "$value": "#1f1f1d", "$type": "color" }, "muted": { "$value": "#4d4d49", "$type": "color" }, "line": { "$value": "#c4c3bd", "$type": "color" }, "accent": { "$value": "#2c5d8f", "$type": "color" }, "on-accent": { "$value": "#ffffff", "$type": "color" } },
      "directory": { "kind": "light", "bg": { "$value": "#dcead6", "$type": "color" }, "surface": { "$value": "#cfe2c8", "$type": "color" }, "ink": { "$value": "#1f2d1b", "$type": "color" }, "muted": { "$value": "#3e5237", "$type": "color" }, "line": { "$value": "#b8cfae", "$type": "color" }, "accent": { "$value": "#1f6b3a", "$type": "color" }, "on-accent": { "$value": "#ffffff", "$type": "color" } },
      "parchment": { "kind": "light", "bg": { "$value": "#f4ecd8", "$type": "color" }, "surface": { "$value": "#ece2c8", "$type": "color" }, "ink": { "$value": "#4a3b28", "$type": "color" }, "muted": { "$value": "#6b5a42", "$type": "color" }, "line": { "$value": "#d9cba8", "$type": "color" }, "accent": { "$value": "#8a4b14", "$type": "color" }, "on-accent": { "$value": "#fff8ea", "$type": "color" } },
      "midnight":  { "kind": "dark",  "bg": { "$value": "#000000", "$type": "color" }, "surface": { "$value": "#0e0e10", "$type": "color" }, "ink": { "$value": "#f0f0f0", "$type": "color" }, "muted": { "$value": "#8f8f96", "$type": "color" }, "line": { "$value": "#222226", "$type": "color" }, "accent": { "$value": "#6db0ff", "$type": "color" }, "on-accent": { "$value": "#06192e", "$type": "color" } }
    }
  },
  "font": {
    "family": {
      "sans":  { "$value": "\"Atkinson Hyperlegible Next\", \"Atkinson Hyperlegible\", system-ui, sans-serif", "$type": "fontFamily" },
      "mono":  { "$value": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace", "$type": "fontFamily" },
      "serif": { "$value": "\"Vollkorn\", Georgia, serif", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "base":        { "$value": "17px",   "$description": "1.0625rem. Body text.", "$type": "dimension" },
      "h1":          { "$value": "clamp(38.4px, 5vw, 57.6px)", "$description": "clamp(2.4rem, 5vw, 3.6rem)", "$type": "dimension" },
      "h2":          { "$value": "24px",   "$description": "1.5rem", "$type": "dimension" },
      "wordmark":    { "$value": "28px",   "$description": "1.75rem", "$type": "dimension" },
      "count":       { "$value": "clamp(41.6px, 6vw, 68px)", "$description": "clamp(2.6rem, 6vw, 4.25rem)", "$type": "dimension" },
      "anti-list":   { "$value": "18.4px", "$description": "1.15rem", "$type": "dimension" },
      "definition-term": { "$value": "18.4px", "$description": "1.15rem", "$type": "dimension" },
      "small":       { "$value": "15.2px", "$description": "0.95rem. Nav, feed rows, definition, after-code text.", "$type": "dimension" },
      "code":        { "$value": "14px",   "$description": "0.875rem. Code blocks, panel unread label, footer.", "$type": "dimension" },
      "label":       { "$value": "13px",   "$description": "0.8125rem. Scheme buttons, fact labels, IPA, anti-feature marks.", "$type": "dimension" },
      "status-mono": { "$value": "14.4px", "$description": "0.9rem", "$type": "dimension" }
    },
    "line-height": {
      "body":     { "$value": 1.6,  "$type": "number" },
      "heading":  { "$value": 1.15, "$type": "number" },
      "count":    { "$value": 1,    "$type": "number" },
      "code":     { "$value": 1.7,  "$type": "number" }
    },
    "letter-spacing": {
      "h1":       { "$value": "-0.025em", "$type": "dimension" },
      "h2":       { "$value": "-0.01em",  "$type": "dimension" },
      "wordmark": { "$value": "-0.01em",  "$type": "dimension" },
      "count":    { "$value": "-0.04em",  "$type": "dimension" }
    }
  },
  "space": {
    "1":  { "$value": "4px",  "$description": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "8.8px", "$description": "0.55rem, feed row vertical padding and panel note", "$type": "dimension" },
    "3":  { "$value": "12px", "$description": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "16px", "$description": "1rem", "$type": "dimension" },
    "5":  { "$value": "20px", "$description": "1.25rem, page side gutter", "$type": "dimension" },
    "6":  { "$value": "24px", "$description": "1.5rem", "$type": "dimension" },
    "8":  { "$value": "32px", "$description": "2rem", "$type": "dimension" },
    "9":  { "$value": "48px", "$description": "3rem", "$type": "dimension" },
    "note": "Values above are the ones used in style.css. Other exact values are listed per component in DESIGN-SYSTEM.md."
  },
  "radius": {
    "control": { "$value": "3px", "$type": "dimension" },
    "panel":   { "$value": "4px", "$type": "dimension" }
  },
  "border": {
    "width":  { "$value": "1px", "$type": "dimension" },
    "airmail-edge-width": { "$value": "7px", "$type": "dimension" }
  },
  "layout": {
    "content-max-width": { "$value": "1088px", "$description": "68rem", "$type": "dimension" },
    "breakpoint-stack":  { "$value": "832px",  "$description": "52rem. At or below this width all two-column grids become one column.", "$type": "dimension" }
  },
  "motion": {
    "transition": { "$value": "120ms", "$description": "background-color and color on .btn and .nav a, only when prefers-reduced-motion is not reduce.", "$type": "duration" }
  }
}
